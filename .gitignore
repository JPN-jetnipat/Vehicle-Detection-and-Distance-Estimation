# Python
.venv/
__pycache__/
*.pyc

# YOLO training outputs (ultralytics default: runs/detect/<name>/)
runs/

# Model weights / checkpoints
*.pt
*.pth

# Datasets - regenerable via RUNBOOK.md (raw download + tools/*.py conversion)
dataset/raw/
dataset/yolo/images/
dataset/yolo/labels/
dataset/yolo/*.json
dataset/yolo/*.csv
dataset/yolo/splits/

# VS Code settings
.vscode/

# macOS
.DS_Store

# training/console logs
*.log
nohup.out

# converter eyeball-check images
viz_out/

# never ever commit an API key
kaggle.json

# results tables (regenerated from runs/metrics via tools/make_results_table.py)
# comment this out once you want a specific results snapshot committed for the writeup
# results/

# Jupyter autosave checkpoints
.ipynb_checkpoints/

# leftover artifacts from the 2026-08-16 broken-symlink repair (harmless,
# left on disk since this filesystem blocks deleting pre-existing files;
# just keep them out of git)
*_broken_OLD/
*_broken_link
splits_check/

# Method 3 low-light augmented copies (~10 GB) - regenerable via
# tools/augment_lowlight.py, same reasoning as dataset/yolo/images/ above.
dataset/lowlight/
dataset/lowlight_probe/

# JEPA stage-1/stage-2 run outputs (checkpoints already covered by *.pt/*.pth,
# this also catches the TensorBoard event files and metrics csv)
runs_jepa/

# Meta's released I-JEPA checkpoint (~2.5 GB tar) - fetch with the wget in
# docs/jepa-runbook.md, never commit it
weights/*.tar
dataset/lowlight

# review diffs generated during doc edits - git history is the real record
docs/*.diff

domain_examples/
# ExDark external night test set (2026-11-10) - regenerable via tools/exdark_to_coco.py.
# Images are symlinks to the raw download; splits/exdark/ IS tracked.
dataset/exdark/

# RTTS external fog test set (2026-11-13) - regenerable via tools/rtts_to_coco.py; splits/rtts/ IS tracked.
dataset/rtts/

# DAWN external weather test set (2026-11-14) - regenerable via tools/dawn_to_coco.py; splits/dawn/ IS tracked.
dataset/dawn/
