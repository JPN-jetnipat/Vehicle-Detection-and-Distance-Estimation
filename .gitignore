# Python
.venv/
__pycache__/
*.pyc

# Dataset: track everything except the raw source data, generated image
# splits, and the materialized image binaries (too large for GitHub) -
# labels/attr_index/splits stay tracked so the repo is still reproducible.
dataset/raw/
dataset/images/
dataset/yolo/images/
dataset.zip
dataset.tar

# Fully derived from dataset/yolo/ + scripts/build_preprocessed_dataset.py -
# regenerate on whichever machine trains condprep_v1, don't track output.
dataset/yolo_preprocessed/

# Machine-specific absolute-path split lists, regenerated by scripts/resolve_splits.py
dataset/yolo/splits/*_resolved.txt

# Same rules for the archived old-version dataset copy
legacy_yolov5/dataset/*/
!legacy_yolov5/dataset/*.yaml
!legacy_yolov5/dataset/*.py

# VS Code settings
.vscode/
.ipynb_checkpoints/

yolov5.zip
venv/